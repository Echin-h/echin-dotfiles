#!/bin/zsh
# Review Git revisions without switching branches or changing the working tree.
set -eu
review_editor=${MATE_REVIEW_NVIM:-nvim}

usage() {
  print '用法：mreview [分支 | HASH | A B | A..B | A...B]'
  print '      mreview --commit HASH'
  print '      mreview --history [分支或范围]'
  print '  mreview                  审阅默认主分支共同祖先到 HEAD 的整体改动'
  print '  mreview feature/name     审阅该分支的整体改动'
  print '  mreview HASH             审阅一次提交（第一父提交 → 该提交）'
  print '  mreview --commit HASH    明确指定单次提交，支持首次提交'
  print '  mreview A B / A..B       比较两个完整快照'
  print '  mreview A...B            比较共同祖先到 B 的整体改动'
  print '  mreview --history       在同一审阅页选择 HEAD 历史，默认最新提交'
  print '  mreview --history A..B  只浏览该范围的提交'
  print '顶部切换整体改动／提交历史；提交先加载 20 条，可继续加载。'
  print '左栏切换改动文件／完整目录；定义、引用、大纲统一在右侧预览。'
  print '缺失的 hash 会从配置的远程获取；不会切换分支或修改工作文件。'
  print 'MATE_REVIEW_BASE 指定默认基准；MATE_REVIEW_NVIM 指定 Neovim 程序。'
}

ensure_commit() {
  local revision="$1" resolved
  if [[ "$revision" =~ '^[0-9a-fA-F]{7,64}$' ]]; then
    python3 "$HOME/.local/lib/mate-code/resolve-review-commit.py" "$revision"
    return
  fi
  if resolved=$(git rev-parse --verify --quiet --end-of-options "${revision}^{commit}"); then
    print -r -- "$resolved"
    return
  fi
  print -u2 -- "找不到本地版本：${revision}"
  return 1
}

open_history() {
  export MATE_REVIEW_MODE=history
  export MATE_REVIEW_RANGE="$1"
  git rev-list --max-count=1 "$MATE_REVIEW_RANGE" -- >/dev/null
  exec "$review_editor" -c 'lua require("config.review_commits").open_history()'
}

open_commit() {
  export MATE_REVIEW_MODE=commit
  MATE_REVIEW_COMMIT=$(ensure_commit "$1") || return 1
  export MATE_REVIEW_COMMIT
  # ^! is Diffview's native single-commit syntax: it handles an initial commit
  # as an empty-tree diff and a merge as its first-parent diff.
  export MATE_REVIEW_RANGE="${MATE_REVIEW_COMMIT}^!"
  export MATE_REVIEW_HISTORY_RANGE="$MATE_REVIEW_RANGE"
  exec "$review_editor" -c 'lua vim.api.nvim_cmd({cmd="DiffviewOpen",args={vim.env.MATE_REVIEW_RANGE}},{})'
}

default_base() {
  if [[ -n "${MATE_REVIEW_BASE:-}" ]]; then
    print -r -- "$MATE_REVIEW_BASE"
    return
  fi
  local remote_base
  if remote_base=$(git symbolic-ref --quiet --short refs/remotes/origin/HEAD); then
    print -r -- "$remote_base"
    return
  fi
  local candidate
  for candidate in origin/main main origin/master master; do
    if git rev-parse --verify --quiet --end-of-options "${candidate}^{commit}" >/dev/null; then
      print -r -- "$candidate"
      return
    fi
  done
  print -u2 '无法确定基准分支，请指定两个版本，例如：mreview main HEAD'
  return 1
}

case "${1:-}" in
  --help|-h) usage; exit 0 ;;
  --commit)
    shift
    if (( $# != 1 )) || [[ "$1" == -* ]]; then usage >&2; exit 2; fi
    open_commit "$1"
    ;;
  --history)
    shift
    if (( $# > 1 )) || [[ "${1:-}" == -* ]]; then usage >&2; exit 2; fi
    open_history "${1:-HEAD}"
    ;;
esac

if (( $# > 2 )); then usage >&2; exit 2; fi
for revision in "$@"; do
  if [[ "$revision" == -* ]]; then usage >&2; exit 2; fi
done

if (( $# == 1 )) && [[ "$1" != *..* ]]; then
  if [[ "$1" =~ '^[0-9a-fA-F]{7,64}$' ]]; then
    open_commit "$1"
  else
    ensure_commit "$1" >/dev/null
  fi
fi

comparison='...'
if (( $# == 2 )); then
  left="$1"
  right="$2"
  comparison='..'
elif (( $# == 1 )) && [[ "$1" == *...* ]]; then
  left="${1%%...*}"
  right="${1#*...}"
elif (( $# == 1 )) && [[ "$1" == *..* ]]; then
  left="${1%%..*}"
  right="${1#*..}"
  comparison='..'
else
  left=$(default_base)
  right="${1:-HEAD}"
fi
left="${left:-HEAD}"
right="${right:-HEAD}"
ensure_commit "$left" >/dev/null
ensure_commit "$right" >/dev/null
if [[ "$comparison" == '...' ]]; then
  if ! git merge-base "$left" "$right" >/dev/null; then
    print -u2 '这两个版本没有可用的共同祖先；可用 mreview A B 直接比较快照。'
    exit 1
  fi
  export MATE_REVIEW_HISTORY_RANGE="$(git merge-base "$left" "$right")..${right}"
else
  export MATE_REVIEW_HISTORY_RANGE="${left}..${right}"
fi
export MATE_REVIEW_RANGE="${left}${comparison}${right}"
export MATE_REVIEW_MODE=diff
exec "$review_editor" -c 'lua vim.api.nvim_cmd({cmd="DiffviewOpen",args={vim.env.MATE_REVIEW_RANGE}},{})'
